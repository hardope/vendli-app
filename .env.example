# Seller app Vite environment variables
# These are passed to the frontend at build/run time (public to the browser)

# Backend API base URL
VITE_BACKEND_URL=http://localhost:3000

# Seller app URL (for redirects, links)
VITE_SELLER_APP_URL=http://localhost:5174

# Landing page URL
VITE_LANDING_URL=https://www.vendli.ng
